{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prefix-browser",
  "main": "workers/worker.js",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": { "enabled": false }
}
